<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="ui.controller.CadastroVeiculoController" spacing="10" padding="16">
    <Label text="Cadastro de Veículo" style="-fx-font-size: 16px; -fx-font-weight: bold;" />
    <TextField fx:id="montadoraField" promptText="Montadora" />
    <TextField fx:id="modeloField" promptText="Modelo" />
    <TextField fx:id="versaoField" promptText="Versão" />
    <Button text="Salvar" onAction="#onSalvar" />
</VBox>
