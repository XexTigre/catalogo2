<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="ui.controller.PesquisaController" spacing="16" padding="20">
    <Label text="Pesquisa de Produtos" style="-fx-font-size: 20px; -fx-font-weight: bold;" />

    <VBox spacing="8">
        <Label text="Código" />
        <TextField fx:id="codigoField" promptText="Código do produto" />

        <Label text="Descrição" />
        <TextField fx:id="descricaoField" promptText="Descrição do produto" />

        <Label text="Marca" />
        <ComboBox fx:id="marcaCombo" />

        <Label text="Grupo" />
        <ComboBox fx:id="grupoCombo" />
    </VBox>

    <HBox spacing="12">
        <Button text="Pesquisar" onAction="#onPesquisar" />
        <Button text="Cadastro Produto" onAction="#onAbrirCadastroProduto" />
        <Button text="Cadastros Base" onAction="#onAbrirCadastrosBase" />
    </HBox>
</VBox>
