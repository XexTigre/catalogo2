<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="ui.controller.CadastroGrupoController" spacing="10" padding="16">
    <Label text="Cadastro de Grupo" style="-fx-font-size: 16px; -fx-font-weight: bold;" />
    <TextField fx:id="nomeField" promptText="Nome do grupo" />
    <TextField fx:id="ordemField" promptText="Ordem" />
    <CheckBox fx:id="visivelMenuCheck" text="Visível no menu" />
    <Button text="Salvar" onAction="#onSalvar" />
</VBox>
