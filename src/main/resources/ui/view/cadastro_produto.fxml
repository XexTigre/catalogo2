<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="ui.controller.CadastroProdutoController" padding="12">
    <center>
        <TabPane>
            <tabs>
                <Tab text="Dados" closable="false">
                    <VBox spacing="10" padding="12">
                        <Label text="Marca" />
                        <ComboBox promptText="Marca" />
                        <Label text="Código" />
                        <TextField promptText="Código" />
                        <Label text="Descrição" />
                        <TextField promptText="Descrição" />
                        <Label text="Grupo" />
                        <ComboBox promptText="Grupo" />
                        <Label text="Observação / Especificações" />
                        <TextArea promptText="Observações" prefRowCount="4" />
                        <Label text="Aplicação Resumida" />
                        <TextArea promptText="Aplicação resumida" prefRowCount="3" />
                    </VBox>
                </Tab>
                <Tab text="Imagens" closable="false">
                    <VBox spacing="12" padding="12">
                        <HBox spacing="8">
                            <Button text="Adicionar imagem" />
                            <Button text="Remover selecionada" />
                        </HBox>
                        <TableView>
                            <columns>
                                <TableColumn text="Tipo" prefWidth="120" />
                                <TableColumn text="Título" prefWidth="200" />
                                <TableColumn text="Caminho" prefWidth="320" />
                                <TableColumn text="Ordem" prefWidth="60" />
                            </columns>
                        </TableView>
                    </VBox>
                </Tab>
                <Tab text="Referências" closable="false">
                    <VBox spacing="12" padding="12">
                        <Button text="+" onAction="#onAdicionarReferencia" />
                        <VBox fx:id="referenciasContainer" spacing="8" />
                    </VBox>
                </Tab>
                <Tab text="Aplicações" closable="false">
                    <VBox spacing="12" padding="12">
                        <Button text="+" onAction="#onAdicionarAplicacao" />
                        <VBox fx:id="aplicacoesContainer" spacing="8" />
                    </VBox>
                </Tab>
                <Tab text="Relacionados" closable="false">
                    <VBox spacing="12" padding="12">
                        <HBox spacing="8">
                            <TextField promptText="Buscar produto" />
                            <Button text="Adicionar" />
                        </HBox>
                        <ListView prefHeight="200" />
                    </VBox>
                </Tab>
            </tabs>
        </TabPane>
    </center>
</BorderPane>
